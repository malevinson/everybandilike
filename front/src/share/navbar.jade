.navbar
    .container-fluid
        .navbar-header
            btn.btn.btn-collapse(ng-click="share.openAside('left')")
                i.fa.fa-bars
            btn.btn.btn-collapse.right.visible-xs(ng-init='navCollapsed = true', ng-click='navCollapsed = !navCollapsed', ng-show = 'share.user')
                i.fa.fa-bars

            a.brand(ui-sref = "share({ id : ''})")
                img(src='images/logo_ebl.png', height='30')
                .beta BETA

        .nav.nav-center
            btn.btn.btn-danger.w-icon(ng-if = "share.user_role =='owner' && share.user", ng-click = 'share.upgrade()')
                i.fa.fa-level-up
                | Personalized Your URL
            btn.btn.btn-danger.w-icon(ng-if = "share.user_role =='owner' && !share.user", ng-click = 'share.login()')
                i.fa.fa-share-alt-square
                | Join to Share or Save
            btn.btn.btn-danger.w-icon(ng-if = "share.user_role =='viewer' && !share.user", ui-sref = "share({ id: ''})")
                i.fa.fa-share-alt-square
                | Create your own collection

        .navbar-collapse.collapse(uib-collapse='navCollapsed')
            ul.nav.navbar-nav.navbar-right(ng-if = 'share.user')
                li.dropdown(uib-dropdown)
                    a.dropdown-toggle(uib-dropdown-toggle)
                        img.avatar(ng-src='{{ share.user.picture }}')
                        span {{ share.user.first_name ? share.user.first_name : share.user.email }} {{ share.user.last_name }} {{ share.user.hash }}
                        span.caret

                    ul.uib-dropdown-menu(uib-dropdown-menu)
                        li: a(ui-sref='share({ id : share.user._id })') My Collection

                        li.divider

                        li: a(ng-click='share.logout()')
                            span.color-red Logout
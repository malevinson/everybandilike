include ./navbar.jade

.main.container(ng-show = 'share.loaded')
    .row
        .col-sm-4.col-xs-12.left.hidden-xs
            btn.btn.btn-add(ng-click='share.addGenres()', ng-if = "share.user_role =='owner'")
                i.fa.fa-plus
                | Add Artist by Genre

        .col-sm-4.col-xs-12

        .col-sm-4.col-xs-12.social-btn(ng-if = "share.user_role =='owner' && share.user")
            btn.btn.btn-danger(ng-if = 'share.user', ng-click = 'share.share()')
                i.fa.fa-share-alt-square
                | Get Shareable Link

            btn.btn.facebook(socialshare, socialshare-provider="facebook",
                             socialshare-via="{{CONFIG.facebook_id}}",
                             socialshare-text="Check out my music collection!",
                             socialshare-redirect-uri="{{ share.share_link }}",
                             socialshare-url="{{ share.share_link }}")
                i.fa.fa-facebook
                | Share on Facebook
            btn.btn.twitter(socialshare, socialshare-provider="twitter",
                            socialshare-hashtags="everybandilike",
                            socialshare-text="Checkout my music collection! @everybandilike",
                            socialshare-url="{{ share.share_link }}")
                i.fa.fa-twitter
                | Share on Twitter
            btn.btn.instagram()
                i.fa.fa-instagram
                | Share on Instagram

        .col-sm-4.col-xs-12.social-btn(ng-if = "share.user_role =='viewer' && share.user")
            btn.btn.facebook(socialshare, socialshare-provider="facebook",
            socialshare-via="{{CONFIG.facebook_id}}",
            socialshare-text="Check out this awesome site!",
            socialshare-redirect-uri="{{ share.share_link }}",
            socialshare-url="{{ share.share_link }}")
                i.fa.fa-facebook
                | Share on Facebook

            btn.btn.twitter(socialshare, socialshare-provider="twitter",
            socialshare-hashtags="ebil, everybandilike, streamfeed",
            socialshare-text="Checkout checkout this awesome site!",
            socialshare-url="{{ share.share_link }}")
                i.fa.fa-twitter
                | Share on Twitter
            btn.btn.instagram()
                i.fa.fa-instagram
                | Share on Instagram

        .col-sm-4.col-xs-12.social-btn(ng-if = "!share.user")
            btn.btn.facebook(ng-click = 'share.login()')
                i.fa.fa-facebook
                | Share on Facebook

            btn.btn.twitter(ng-click = 'share.login()')
                i.fa.fa-twitter
                | Share on Twitter

            btn.btn.instagram()
                i.fa.fa-instagram
                | Share on Instagram

    .row
        .col-md-12
            .artists.row(uib-popover-template='share.popover.template', popover-is-open= 'share.popover.show', popover-placement='top', popover-trigger='none')
                i.icon-heart-red
                i.icon-heart-red
                i.icon-heart-red

                ul.clearfix
                    li(ng-repeat="artist in share.artists.three track by $index")
                        .thumbnail
                            img(ng-src='{{ artist.artist.picture }}', alt='figure')
                        span.name {{ artist.artist.name }}
                        .hover(ng-if = "share.user_role =='owner'")
                            i.fa.fa-times(ng-click="share.remove(artist, 'three', $index)")

                    li.add(ng-init = 'share.showAddThree = false', ng-click = 'share.showAddThree = !share.showAddThree', ng-if = "share.user_role =='owner'")
                        i.fa.fa-plus

                .add-container.col-md-6.col-md-offset-3(ng-if='share.showAddThree')
                    .form-group(ng-init = "share.searchThree = ''")
                        i.fa.fa-search
                        input.form-control(type="text", ng-model='share.searchThree', placeholder="Taylor Swift, Coldplay, Passion Pit")
                    btn.btn.btn-danger(ng-disabled = "share.searchThree == ''", ng-click = 'share.add(share.searchThree, 3)') Add

            .artists.row
                i.icon-heart-red
                i.icon-heart-red

                ul.clearfix
                    li(ng-repeat="artist in share.artists.two track by $index")
                        .thumbnail
                            img(ng-src='{{ artist.artist.picture }}', alt='figure')
                        span.name {{ artist.artist.name }}
                        .hover(ng-if = "share.user_role =='owner'")
                            i.fa.fa-times(ng-click="share.remove(artist, 'two', $index)")

                    li.add(ng-init = 'share.showAddTwo = false', ng-click = 'share.showAddTwo = !share.showAddTwo', ng-if = "share.user_role =='owner'")
                        i.fa.fa-plus

                .add-container.col-md-6.col-md-offset-3(ng-if='share.showAddTwo')
                    .form-group(ng-init = "share.searchTwo = ''")
                        i.fa.fa-search
                        input.form-control(type="text", ng-model='share.searchTwo', placeholder="Taylor Swift, Coldplay, Passion Pit")
                    btn.btn.btn-danger(ng-disabled = "share.searchTwo == ''", ng-click = 'share.add(share.searchTwo, 2)') Add

            .artists.row
                i.icon-heart-red

                ul.clearfix
                    li(ng-repeat="artist in share.artists.one track by $index")
                        .thumbnail
                            img(ng-src='{{ artist.artist.picture }}', alt='figure')
                        span.name {{ artist.artist.name }}
                        .hover(ng-if = "share.user_role =='owner'")
                            i.fa.fa-times(ng-click="share.remove(artist, 'one', $index)")

                    li.add(ng-init = 'share.showAddOne = false', ng-click = 'share.showAddOne = !share.showAddOne', ng-if = "share.user_role =='owner'")
                        i.fa.fa-plus

                .add-container.col-md-6.col-md-offset-3(ng-if='share.showAddOne')
                    .form-group(ng-init = "share.searchOne = ''")
                        i.fa.fa-search
                        input.form-control(type="text", ng-model='share.searchOne', placeholder="Taylor Swift, Coldplay, Passion Pit")
                    btn.btn.btn-danger(ng-disabled = "share.searchOne == ''", ng-click = 'share.add(share.searchOne, 1)') Add
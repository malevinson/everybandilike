.modal-content
    .modal-header
        h4.modal-title Share with others
    .modal-body

        .form-group
            label Get the shareable link
            input.form-control(ng-model = 'modal.url')

    .modal-footer
        btn.btn.btn-success(clipboard, text='modal.url', on-copied = 'modal.successCopied()') Copy link
        btn.btn.btn-warning(ng-click = 'modal.close()') Cancel
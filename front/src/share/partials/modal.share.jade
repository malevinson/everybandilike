.modal-content
    .modal-header
        i.fa.fa-share-alt
    .modal-body

        form.form-group
            label Get the shareable link
            input.form-control(ng-model = 'modal.share_link')

    .modal-footer
        btn.btn.btn-success(clipboard, text='modal.share_link', on-copied = 'modal.successCopied()') Copy link
        btn.btn.btn-warning(ng-click = 'modal.close()') Cancel
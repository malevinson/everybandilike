div(ng-switch="modal.modalMode")
    .modal-header
        i.fa.fa-level-up
    .modal-content(ng-switch-when="upgrade")
        .modal-body.clearfix
            .plan
                p.title Personalized Your Url
                p.price $1.00
                p.example Example: everybandilike.com/Ben's_list
                br
                btn.btn.btn-warning(ng-click = "modal.close()") Cancel
                btn.btn.btn-danger.btn-purchase(ng-click = "modal.modalMode = 'caught'") Purchase

    .modal-content(ng-switch-when="caught")
        .modal-body
            p You caught us before feature is ready!
            p Coming Soon
        .modal-footer
            btn.btn.btn-danger(ng-click = "modal.close()") OK

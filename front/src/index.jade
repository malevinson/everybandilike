doctype html

html(ng-app="ebil", ng-cloak, ng-strict-di)
    head
        title everybandilike
        base(href="/")
        meta(charset='utf-8')
        meta(name="viewport", content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0")
        link(rel="stylesheet", href="/css/vendor.css", type="text/css")
        link(rel="stylesheet", href="/css/styles.css", type="text/css")
        link(rel="icon", type="image/png", href="/images/favicon.ico")

    body(ng-class = "$state.current.name|expandState")
        main(ui-view)

        footer.hidden-xs
            ul.pull-left
                li: a.non-link The simplest way to share your favorite bands with a link.
            ul.pull-right
                li: a(href='mailto:everybandilike@gmail.com') Contact Us
                li: a(href = 'http://streamfeed.fm/', target='_blank') Try STREAMFEED

                li: a(href="https://www.facebook.com/everybandilike/" target="_blank") Like us
                    i.fa.fa-facebook-square
                li: a(href="https://twitter.com/everybandilike" target="_blank") Follow us
                    i.fa.fa-twitter-square

        script(type="text/javascript").
            var CONFIG = !{ JSON.stringify(config) };

        script(type='text/javascript', src='/js/vendor.js')
        script(type='text/javascript', src='/js/all.js')
        script(type="text/javascript").
            (function(u, t, c, s, r) { !t[c] && (t[c] = { projectId: '56d09c0909df0105d99bc014'}) && (r = u.createElement(s)) && (r.src = 'https://mobile.usabilitytools.com/recorder/tracker/tracker.js') && (u.head.appendChild(r)); })(document, window, 'UsabilityTools Session Recording', 'script');